{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caner.hk/desktile/schemas/app-manifest-v1.json",
  "title": "DeskTile application manifest",
  "description": "Device string limits are UTF-8 byte limits. Schema maxLength is an additional character limit; build_dtapp.py and device validation enforce byte lengths and path rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "name", "version", "version_code", "runtime", "entry", "sdk", "icons", "tile", "permissions"],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"type": "string", "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
    "name": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 63},
        {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 63}}
      ]
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "version_code": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "runtime": {"enum": ["javascript", "native-builtin", "native-module"]},
    "entry": {"type": "object", "minProperties": 1},
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "target"],
      "properties": {
        "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "target": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "tile"],
      "properties": {
        "application": {"type": "string", "minLength": 1},
        "tile": {"type": "string", "minLength": 1},
        "splash": {"type": "string", "minLength": 1},
        "notification": {
          "type":"object", "additionalProperties":false, "required":["path","mode"],
          "properties": {
            "path":{"type":"string","minLength":1},
            "mode":{"enum":["system","custom"]}
          },
          "description":"Dedicated notification icon. system: DTI1 alpha8 tinted by the system; custom: DTI1 RGB565 with optional transparency, preserving original colors. Square 16..128 px. Omission uses the system bell."
        },
          "appearances": {
            "type": "object", "additionalProperties": false, "required": ["default","choices"],
            "properties": {
              "default": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,16}$"},
              "choices": {"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,16}$"}}
            },
            "description":"Default must belong to choices. Each ID supplies application and tile files in an ID subdirectory beside the base icons. Splash is unchanged."
          },
        "tile_variants": {"type": "boolean", "description": "Use tile-1x1.dti, tile-2x2.dti, tile-4x2.dti and tile-4x4.dti beside the base tile.dti, at 40, 64, 80 and 128 pixels respectively. Filenames use the base tile stem."}
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_size", "supported_sizes"],
      "properties": {
        "transition_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "Optional resize content-transition color. Absence preserves the shell fallback."},
        "appearance_transition_colors": {
          "type": "object", "minProperties": 1, "maxProperties": 16,
          "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,16}$"},
          "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "description": "Keys must be declared icon appearance IDs, checked by the package builder and device. Selected appearance overrides transition_color."
        },
        "default_size": {"enum": ["1x1", "2x2", "4x2", "4x4"]},
        "supported_sizes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["1x1", "2x2", "4x2", "4x4"]}
        },
        "names": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {"1x1": {"$ref": "#/$defs/tileName"}, "2x2": {"$ref": "#/$defs/tileName"}, "4x2": {"$ref": "#/$defs/tileName"}, "4x4": {"$ref": "#/$defs/tileName"}}
        }
      }
    },
    "permissions": {
      "type": "array", "uniqueItems": true, "maxItems": 16,
      "items": {"enum": ["network", "user-files.read", "user-files.write", "bluetooth", "notifications", "background", "display.keep-awake", "device.basic-info", "system.settings", "system.update", "package.install", "package.manage", "device.provision", "calendar.read", "calendar.write", "tasks.read", "tasks.write"]}
    }
  },
  "$defs": {"tileName": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 63}, {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"zh-CN": {"type": "string", "minLength": 1, "maxLength": 63}, "zh-HK": {"type": "string", "minLength": 1, "maxLength": 63}, "en": {"type": "string", "minLength": 1, "maxLength": 63}, "en-US": {"type": "string", "minLength": 1, "maxLength": 63}}}]}},
  "allOf": [
    {"if": {"properties": {"runtime": {"const": "javascript"}}},
     "then": {"properties": {"entry": {"additionalProperties": false, "required": ["document", "script"], "properties": {"document": {"type": "string"}, "script": {"type": "string"}}}}}},
    {"if": {"properties": {"runtime": {"const": "native-module"}}},
     "then": {"properties": {"entry": {"additionalProperties": false, "required": ["module"], "properties": {"module": {"type": "string"}}}}}},
    {"if": {"properties": {"runtime": {"const": "native-builtin"}}},
     "then": {"properties": {"entry": {"additionalProperties": false, "required": ["symbol"], "properties": {"symbol": {"type": "string"}}}}}}
  ]
}
